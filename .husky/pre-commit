#!/bin/sh
set -e

# Husky v10 compatible initialization
echo "🔤 Checking spelling and markdown..."

# Run cspell on changed markdown files
npx cspell "**/*.md" || { echo "❌ Spelling errors detected (en-GB). Add words to cspell.json if needed."; exit 1; }

# Run markdownlint on changed markdown files  
npx markdownlint-cli2 "**/*.md" || { echo "❌ Markdown linting errors detected. Fix and retry."; exit 1; }

echo "✅ Spelling and markdown checks passed! (Tests run in CI)"

