#!/bin/sh
set -e

echo "🏗️ Running local build gate before push..."
node -e "const fs=require('fs'); try{fs.rmSync('.next',{recursive:true,force:true,maxRetries:5,retryDelay:200});}catch(_e){}"
node scripts/generate-migration-list.js

TMP_LOG=".git/.pre-push-build.log"

if node ./node_modules/next/dist/bin/next build 2>&1 | tee "$TMP_LOG"; then
	echo "✅ Build gate passed (Turbopack)."
	exit 0
fi

if grep -q "EBUSY: resource busy or locked" "$TMP_LOG"; then
	echo "⚠️ Turbopack hit a Windows file lock (EBUSY). Retrying with webpack..."
	node -e "const fs=require('fs'); try{fs.rmSync('.next',{recursive:true,force:true,maxRetries:5,retryDelay:200});}catch(_e){}"
	node ./node_modules/next/dist/bin/next build --webpack || { echo "❌ Build failed (webpack fallback). Fix errors before pushing."; exit 1; }
	echo "✅ Build gate passed (webpack fallback)."
	exit 0
fi

echo "❌ Build failed. Fix errors before pushing."
exit 1

