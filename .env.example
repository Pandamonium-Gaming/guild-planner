# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key (for server-side operations that bypass RLS)
# WARNING: Keep this secret! Never expose in client-side code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Site URL (for OAuth redirects)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Auth stack feature flag for migration.
# Use v1 for current Supabase auth path, v2 for app-owned auth path.
AUTH_STACK=v1
NEXT_PUBLIC_AUTH_STACK=v1

# Auth.js configuration (used when AUTH_STACK=v2)
AUTH_SECRET=replace-with-strong-random-secret
AUTH_DISCORD_ID=your-discord-client-id
AUTH_DISCORD_SECRET=your-discord-client-secret
# Optional override for Auth.js adapter DB connection (falls back to DATABASE_URL)
AUTH_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/guild_planner
# Docker compose profile override (if using docker-compose.pr02-auth.yml with host access):
# AUTH_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/guild_planner_auth
# database (preferred) or jwt
AUTH_SESSION_STRATEGY=database

# Note: NEXT_PUBLIC_ keys are safe to expose in the browser
# SUPABASE_SERVICE_ROLE_KEY is SERVER-ONLY and must never be exposed
