# Copy to .env.stack before running docker-compose.stack.yml

# Public app URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Keep current Supabase domain-data path while PR-06 migration is in progress
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth stack selector
AUTH_STACK=v2
NEXT_PUBLIC_AUTH_STACK=v2

# Auth.js configuration
AUTH_SECRET=replace-with-strong-random-secret
AUTH_DISCORD_ID=your-discord-client-id
AUTH_DISCORD_SECRET=your-discord-client-secret

# Session strategy for migration rehearsal
# Use database mode to validate containerized Postgres path.
AUTH_SESSION_STRATEGY=database

# These are provided by docker-compose.stack.yml by default, but included
# here to make local overrides explicit when needed.
AUTH_DATABASE_URL=postgresql://postgres:postgres@db:5432/guild_planner
DATABASE_URL=postgresql://postgres:postgres@db:5432/guild_planner
