# Copy to .env.production and fill with real production values.
# This file is used by docker-compose.prod.yml via env_file.

# Public app URL
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Supabase (domain data path)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth stack selector
AUTH_STACK=v2
NEXT_PUBLIC_AUTH_STACK=v2

# Auth.js
AUTH_SECRET=replace-with-strong-random-secret
AUTH_DISCORD_ID=your-discord-client-id
AUTH_DISCORD_SECRET=your-discord-client-secret
AUTH_SESSION_STRATEGY=database

# Auth.js adapter database (external DB, not provided by docker-compose.yml)
# Example managed PostgreSQL URL:
AUTH_DATABASE_URL=postgresql://username:password@your-db-host:5432/guild_planner_auth
DATABASE_URL=postgresql://username:password@your-db-host:5432/guild_planner_auth
